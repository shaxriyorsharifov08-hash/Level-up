rules_version = '2';

// Security rules for Money Tracker.
// Each signed-in user can read and write ONLY their own transactions,
// stored under users/{their-uid}/transactions/*. No one can touch
// another user's data, and signed-out requests are rejected.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/transactions/{txId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
