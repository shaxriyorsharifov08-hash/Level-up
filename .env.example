# Copy this file to `.env` and adjust the values.

# ─── Database ────────────────────────────────────────────────────────────────
# Supabase (recommended): Project → "Connect" button → "Connection string". See docs/SUPABASE.md.
#
#   DATABASE_URL = Transaction pooler (port 6543), used by the running app:
#     postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   DIRECT_URL   = Session pooler (port 5432), used by migrations and the seed script:
#     postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Special characters in the password must be URL-encoded (@ → %40, # → %23, / → %2F).
# SSL is turned on automatically for Supabase hosts.
#
# Local alternatives: `docker compose up -d` (default values below), or the Supabase CLI
# (`supabase start`): postgresql://postgres:postgres@127.0.0.1:54322/postgres for both URLs.
DATABASE_URL="postgres://levelup:levelup@localhost:5432/levelup"
DIRECT_URL=""

# Connections per server instance. Use 1–3 on serverless hosts (Vercel).
DATABASE_POOL_MAX="5"

# Branding for your university (shown across the platform).
NEXT_PUBLIC_APP_NAME="Level Up"
NEXT_PUBLIC_UNIVERSITY_NAME="Your University"
NEXT_PUBLIC_UNIVERSITY_SHORT_NAME="YU"

# IANA time zone used to display and enter event/meeting times, e.g. "Asia/Tashkent".
NEXT_PUBLIC_UNIVERSITY_TIMEZONE="UTC"

# Official university channels (leave empty to hide).
NEXT_PUBLIC_UNIVERSITY_TELEGRAM_URL="https://t.me/your_university"
NEXT_PUBLIC_UNIVERSITY_INSTAGRAM_URL="https://instagram.com/your_university"
NEXT_PUBLIC_UNIVERSITY_WEBSITE_URL="https://example.edu"

# Optional: restrict sign-up to university e-mail addresses, e.g. "student.example.edu,example.edu".
# Leave empty to allow any e-mail address.
ALLOWED_EMAIL_DOMAINS=""
